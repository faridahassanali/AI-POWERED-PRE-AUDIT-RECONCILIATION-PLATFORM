{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Finding",
  "type": "object",

  "required": [
    "finding_id",
    "audit_run_id",
    "control_id",
    "customer_id",
    "severity",
    "assessment_status",
    "finding_status",
    "expected",
    "actual",
    "evidence",
    "policy_references"
  ],

  "properties": {
    "finding_id": {
      "type": "string"
    },

    "audit_run_id": {
      "type": "string"
    },

    "control_id": {
      "type": "string"
    },

    "customer_id": {
      "type": ["string", "null"]
    },

    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },

    "assessment_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE"
      ]
    },

    "finding_status": {
      "type": "string",
      "enum": [
        "REVIEW",
        "CONFIRMED",
        "REJECTED",
        "RESOLVED"
      ]
    },

    "expected": {
      "type": "string"
    },

    "actual": {
      "type": "string"
    },

    "evidence": {
      "type": "object",
      "additionalProperties": true
    },

    "policy_references": {
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "policy_id": {
        "type": "string"
      },
      "version": {
        "type": ["string", "null"]
      },
      "section": {
        "type": ["string", "null"]
      }
    },
    "required": [
      "policy_id",
      "version",
      "section"
    ]
  }
},

    "reviewed_by": {
      "type": ["string", "null"]
    },

    "review_timestamp": {
      "type": ["string", "null"]
    },

    "reviewer_notes": {
      "type": ["string", "null"]
    },

    "ai_explanation": {
      "type": ["string", "null"]
    },

    "ai_recommendation": {
      "type": ["string", "null"]
    }
  },

  "additionalProperties": false
}